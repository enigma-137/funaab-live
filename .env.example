# Browser-visible configuration. Values prefixed with VITE_ are bundled into
# the client, so use only public values here (never service-role credentials).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional WebSocket endpoint. Local development defaults to ws://localhost:8787.
# VITE_WS_URL=wss://your-worker-subdomain.workers.dev

# Keep false for normal use. Enable only for local guest-mode testing.
VITE_ENABLE_GUEST_MODE=false

# TraceIQ browser analytics (public values only; safe to expose in client code)
VITE_TRACEIQ_PROJECT_ID=your-traceiq-project-id
VITE_TRACEIQ_WRITE_KEY=your-traceiq-public-write-key
VITE_TRACEIQ_ENDPOINT=https://api.traceiq.run
VITE_TRACEIQ_DEBUG=false
VITE_TRACEIQ_AUTO_TRACK_PAGE_VIEWS=true
VITE_TRACEIQ_AUTO_CAPTURE_EXCEPTIONS=true
VITE_TRACEIQ_AUTO_CAPTURE_RAGE_CLICKS=true
VITE_TRACEIQ_AUTO_CAPTURE_REQUESTS=true
