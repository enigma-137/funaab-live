# ==============================================================================
# FUNAAB Life - Public Beta Production Environment Configuration
# ==============================================================================

# 1. Supabase Project Configuration (Auth + PostgreSQL)
# Obtain these from your Supabase Dashboard: Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Production Realtime Multiplayer WebSocket URL (Cloudflare Worker)
# Format: wss://funaab-life-multiplayer.<your-subdomain>.workers.dev
# Development fallback: ws://localhost:8787
VITE_WS_URL=wss://your-worker-subdomain.workers.dev

# 3. Guest Mode Safety Toggle
# Set to 'false' for production (Supabase Auth strictly required)
# Set to 'true' ONLY for offline/local development without Supabase
VITE_ENABLE_GUEST_MODE=false

# ==============================================================================
# CLOUDFLARE WORKER SECRETS (Set via `npx wrangler secret put <KEY>`)
# DO NOT put these in the frontend .env or client bundle!
# ==============================================================================
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings
# ALLOWED_ORIGINS=https://your-domain.pages.dev,http://localhost:5173
# ENABLE_GUEST_MODE=false
